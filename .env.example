# Copy to .env and replace every CHANGE_ME. Generate secrets with e.g.:
#   openssl rand -hex 24
APP_ENV=development
LOG_LEVEL=info

POSTGRES_PASSWORD=CHANGE_ME
# Object store: any S3-compatible backend. Pick ONE profile and the matching endpoint:
#   rustfs     -> BLOB_STORE_ENDPOINT=rustfs:9000      (default; Apache-2.0)
#   seaweedfs  -> BLOB_STORE_ENDPOINT=seaweedfs:9000   (Apache-2.0)
#   minio      -> BLOB_STORE_ENDPOINT=minio:9000       (community edition, legacy)
COMPOSE_PROFILES=rustfs
BLOB_STORE_ENDPOINT=rustfs:9000
BLOB_ACCESS_KEY=relayplane
BLOB_SECRET_KEY=CHANGE_ME_min_8_chars
BLOB_PORT=9000
BLOB_STORE_BUCKET=relayplane-media
# host:port that clients use to reach the object store (used in signed URLs handed to clients)
BLOB_PUBLIC_ENDPOINT=localhost:9000

# API
ADMIN_API_KEY=CHANGE_ME
WEBHOOK_SECRET=CHANGE_ME_at_least_16_chars
# Derives the per-subscription signing secrets of tenant webhooks. Empty = derived from WEBHOOK_SECRET (domain-separated).
# Changing it invalidates every existing subscription secret.
SUBSCRIPTION_SECRET=
GATEWAY_PORT=8080

# Provider nodes (one API key per node; nodes are singletons)
EVOLUTION_NODE_01_API_KEY=CHANGE_ME
EVOLUTION_NODE_02_API_KEY=CHANGE_ME
NODE_CAPACITY=50

# Tuning (all optional)
# Throughput ceiling of outbound sends is the number of partitions (one message at a time each), not the number of workers.
# Change it only with the queue drained. See docs/OPERATIONS.md "Carga multi-processo".
COMMAND_PARTITIONS=32
MEDIA_INLINE_MAX_BYTES=262144
MEDIA_DEFAULT_TTL=24h
# attachments of inbound messages: the largest one that is downloaded (negative turns inbound media off) and how long it stays downloadable
INBOUND_MEDIA_MAX_BYTES=26214400
INBOUND_MEDIA_TTL=168h
# requests per second (and burst) each tenant may make on EACH gateway replica; 0 turns the limit off
# personal data retention: finished messages lose recipient and text after this long, dead-lettered webhooks are deleted (0 keeps forever)
RETENTION_MESSAGES=2160h
RETENTION_DEAD_DELIVERIES=720h
API_RATE_PER_SECOND=50
# how often outbound status events are published (bounds their delivery lag; the metric is relayplane_event_delivery_lag_seconds)
OUTBOX_INTERVAL=250ms
API_RATE_BURST=100
RATE_MIN_INTERVAL=1s
RATE_MAX_PER_MINUTE=30
RECONCILER_INTERVAL=10s
# events kept by the event bus; a consumer group further behind than this loses events (alerts fire at 50%/90%)
EVENT_BUS_RETENTION=100000
# how long an UNKNOWN message (ambiguous send) holds back later messages of its instance.
# 0 (default) = until it is resolved via POST /messages/{id}/resolve: strict ordering. A duration (e.g. 15m) trades ordering for availability.
UNKNOWN_BARRIER_TIMEOUT=0
MEDIA_PENDING_TTL=30m
RELAYPLANE_VERSION=dev
